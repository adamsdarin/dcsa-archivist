{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dcsa-library/enriched-document/1.0",
  "type": "object",
  "required": [
    "document_id", "source_document_id", "collection_id", "domain", "robot_text_path", "human_source_path",
    "robot_content_sha256", "authority_role", "authority_priority", "contractor_binding", "current_status",
    "answer_eligibility", "canonical_document_id", "stable_locator_strategy"
  ],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "source_document_id": {"type": "string", "minLength": 1},
    "robot_text_path": {"type": "string", "pattern": "^ROBOT_READABLE_DIRECTORY/"},
    "human_source_path": {"type": "string", "pattern": "^HUMAN_READABLE_DIRECTORY/"},
    "robot_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority_role": {"enum": ["controlling_regulation", "contract_clause", "executive_order", "binding_government_issuance", "dcsa_interpretation", "official_operational_guidance", "incorporated_framework", "training_or_context", "adjudicative_precedent", "historical_reference", "unclassified_role"]},
    "answer_eligibility": {"enum": ["answer_eligible", "unresolved_currency", "precedent_only", "exact_case_only", "historical_only", "excluded_unresolved", "excluded_duplicate", "excluded_by_review"]},
    "duplicate_of": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
